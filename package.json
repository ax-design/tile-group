{
    "name": "@ax-design/tile-group",
    "version": "0.1.2",
    "description": "Web component that implements the tile groups of Axiom Design System, after the Windows 8 Start screen.",
    "main": "build/main.js",
    "module": "es/index.js",
    "typings": "es/index.d.ts",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ax-design/tile-group.git"
    },
    "license": "MIT",
    "sideEffects": false,
    "devDependencies": {
        "@ax-design/reveal-highlight": "^0.6.2",
        "@fluentui/svg-icons": "1.1.343",
        "@types/bun": "latest",
        "playwright": "^1.64.0",
        "typescript": "^5.6.0",
        "winjs": "^4.4.3"
    },
    "scripts": {
        "build": "bun scripts/build.ts",
        "check": "tsc -p tsconfig.json --noEmit",
        "test:browser": "bun test-browser/run.ts",
        "prepublishOnly": "bun run build",
        "test": "bun test",
        "oracle": "bun test/oracle/generate.ts",
        "demo": "bun demo/serve.ts"
    },
    "dependencies": {
        "@ax-design/shape": "^0.2.0",
        "@ax-design/surface": "^0.2.1",
        "@ax-design/typed-om": "^0.1.0"
    },
    "homepage": "https://github.com/ax-design/tile-group#readme",
    "bugs": {
        "url": "https://github.com/ax-design/tile-group/issues"
    },
    "files": [
        "build",
        "es",
        "src"
    ],
    "exports": {
        ".": {
            "types": "./es/index.d.ts",
            "source": "./src/index.ts",
            "import": "./es/index.js",
            "require": "./build/main.js",
            "default": "./es/index.js"
        },
        "./package.json": "./package.json"
    }
}
